<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경 색 (필요하면 투명 가능) -->
    <solid android:color="#1E1F2A" />

    <!-- 테두리 색상 및 두께 -->
    <stroke
        android:width="1dp"
        android:color="#FFFFFF" /> <!-- 원하는 보더 색상 -->

    <!-- 모서리 둥글게 -->
    <corners android:radius="5dp" />
</shape>