<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.aact.sat_pda.screen.scale_list.CARGO_SCALE_LIST_Model" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffffff">

        <GridLayout

            android:id="@+id/subFragmentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:columnCount="2"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/mawb"
                    layout="@layout/cust_label_edit"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    bind:editValue="@{viewModel.mawb}"
                    bind:labelValue="@{`MAWB`}" />

                <include
                    android:id="@+id/acceptSeq"
                    layout="@layout/cust_label_edit"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    bind:editValue="@{viewModel.acceptSeq}"
                    bind:labelValue="@{`순서`}" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/fltDate"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.fltDate}"
                    bind:labelValue="@{`일자`}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/fltNo"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.fltNo}"
                    bind:labelValue="@{`편번`}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/scaleList"
                    layout="@layout/cust_label"
                    bind:labelValue="@{`계량목록`}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/pcsSum"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.pcsSum}"
                    bind:labelValue="@{`합계수량`}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/wtSum"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.wtSum}"
                    bind:labelValue="@{`합계중량`}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/pcs"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.pcs}"
                    bind:labelValue="@{`수량`}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/wt"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.wt}"
                    bind:labelValue="@{`중량`}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/pallet"
                    layout="@layout/cust_label_combo"
                    android:layout_width="165dp"
                    android:layout_height="wrap_content"
                    bind:labelValue="@{`파렛트`}"/>

                <include
                    android:id="@+id/palletPcs"
                    layout="@layout/cust_label_edit"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    bind:editValue="@{viewModel.palletPcs}"
                    bind:labelValue="@{`수량`}" />

                <include
                    android:id="@+id/palletWt"
                    layout="@layout/cust_label_edit"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    bind:editValue="@{viewModel.palletWt}"
                    bind:labelValue="@{`중량`}" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/netWt"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.netWt}"
                    bind:labelValue="@{`순중량`}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/spc"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.spcStr}"
                    bind:labelValue="@{`특수화물`}" />
            </LinearLayout>

        </GridLayout>

    </androidx.core.widget.NestedScrollView>

</layout>