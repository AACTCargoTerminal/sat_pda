<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.aact.sat_pda.screen.import_bd.IMPORT_BD_Model" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffffff">

        <GridLayout
            android:id="@+id/subFragmentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:columnCount="2"
            android:orientation="horizontal">

            <!-- 날짜 입력 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/fltDate"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.fltDate}"
                    bind:labelValue="@{`일자`}" />
            </LinearLayout>

            <!-- 항공편 선택 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/flight"
                    layout="@layout/cust_label_combo"
                    bind:labelValue="@{`항공편`}" />
            </LinearLayout>

            <!-- ULD 선택 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_columnSpan="2"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/uld"
                    layout="@layout/cust_label_combo"
                    bind:labelValue="@{`ULD`}" />
            </LinearLayout>

            <!-- MAWB 선택 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_columnSpan="2"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/mawb"
                    layout="@layout/cust_label_combo"
                    bind:labelValue="@{`MAWB`}" />
            </LinearLayout>

            <!-- HAWB 선택 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_columnSpan="2"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/hawb"
                    layout="@layout/cust_label_combo"
                    bind:labelValue="@{`HAWB`}" />
            </LinearLayout>

            <!-- 배정장소 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_columnSpan="2"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/assign"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.assignCode}"
                    bind:labelValue="@{`배정장소`}" />
            </LinearLayout>

            <!-- 화물명세 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_columnSpan="2"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/cargoDes"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.cargoDescription}"
                    bind:labelValue="@{`화물명세`}" />
            </LinearLayout>

            <!-- 하기수량 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/sumPcs"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.sumPcs}"
                    bind:labelValue="@{`하기수량`}" />
            </LinearLayout>

            <!-- 적하수량 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/sumPcsMfst"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.sumPcsMfst}"
                    bind:labelValue="@{`적하수량`}" />
            </LinearLayout>

            <!-- 하기중량 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/sumWt"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.sumWt}"
                    bind:labelValue="@{`하기중량`}" />
            </LinearLayout>

            <!-- 적하중량 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#F0F0F0"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/sumWtMfst"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.sumWtMfst}"
                    bind:labelValue="@{`적하중량`}" />
            </LinearLayout>

            <!-- 입력수량 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#E8F5E8"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/pcs"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.pcs}"
                    bind:labelValue="@{`입력수량`}" />
            </LinearLayout>

            <!-- 입력중량 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="#E8F5E8"
                android:elevation="3dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/wt"
                    layout="@layout/cust_label_edit"
                    bind:editValue="@{viewModel.wt}"
                    bind:labelValue="@{`입력중량`}" />
            </LinearLayout>

        </GridLayout>

    </androidx.core.widget.NestedScrollView>

</layout>
